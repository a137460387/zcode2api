# 对外 API 鉴权 key（必填）
API_KEY=sk-zcode2api-local
# API 监听（默认 127.0.0.1:28630）
HOST=127.0.0.1
PORT=28630
# farm 服务（浏览器参数农场页）端口
FARM_PORT=28631
# 账号文件目录 / 证书目录
POOL_DIR=./accounts
CERT_DIR=./certs
# 农场自动浏览器：1=无头（默认，无任何可见窗口），0=有头（调试用，能看到页面）
# 两种模式产出的参数都能被上游接受（实测 headless 参数 3/3 成功）。
# 启动器会自动把 UA 换成桌面 Chrome 版本（否则 SDK 见 HeadlessChrome 判 F001，产不出参数）
FARM_HEADLESS=1
CHROME_PATH=
# 是否自动启动农场浏览器：
#   1（默认）= 后台模式，playwright 自动开无头浏览器产参数，无可见窗口、无需人工干预
#   0        = 手动模式，需用你自己的 Chrome 打开 farm 页并保持标签页
FARM_AUTO_BROWSER=1
# 参数池上限与 TTL(ms)
POOL_SIZE=6
PARAM_TTL_MS=480000
# 参数被上游**接受**的时效(ms)，短于 PARAM_TTL_MS（后者只是内存保留时长）。
# 超过它的参数会被池直接丢弃，不再递给上游——实测 48s 的参数已被判 3007，
# 而池里 4 个陈参数会让一次请求把初次+2 次重试全打在陈参数上，客户端拿到 400。
PARAM_USABLE_MS=40000
# 单账号最小请求间隔(ms)；3012 冷却分钟；换号/换参重试上限
ACCOUNT_MIN_INTERVAL_MS=2000
COOLDOWN_3012_MIN=30
MAX_RETRIES=2
# 局域网访问看板密码（空=仅本机免密）
# 注意：这只是**引导密码**。在面板「设置」里改过密码后会写入 panel.json（scrypt 哈希），
# 之后以此文件里的值为准、本项失效。未设置任何密码时，非本机一律 401。
PANEL_PASSWORD=
# 本机是否免密进管理面板。默认 1（本机工具的使用直觉）。
# 面板挂在反向代理后面时设 0：代理回源地址是本机，开着放行等于任何人都能进管理面。
PANEL_LOCAL_BYPASS=1
