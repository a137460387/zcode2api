# 对外 API 鉴权 key（必填）
API_KEY=sk-zcode2api-local
# API 监听。默认 127.0.0.1 = 只有本机能连；要从手机/另一台电脑访问改成 0.0.0.0（改完需重启）
HOST=127.0.0.1
PORT=28630
# farm 服务（浏览器参数农场页）端口
FARM_PORT=28631
# 账号文件目录 / 证书目录
POOL_DIR=./accounts
CERT_DIR=./certs
# 农场自动浏览器：0=有头（默认，会弹出可见的 Chrome 窗口），1=无头（无任何可见窗口）
# 默认有头是实测修正的结论：无头模式（即便启动器已覆盖 UA）会稳定吃 F011，一个参数都产不出，
# 整个 API 只能回 "captcha param pool is empty"；改有头后 F011 立即消失、参数稳定产出。
# 注意这让农场不再完全"无感"——桌面上会出现一个 Chrome 窗口，关掉它就断供。
# 启动器仍会把 UA 换成桌面 Chrome 真实版本（防写死旧版本被判低分 → 上游 3012）
FARM_HEADLESS=0
CHROME_PATH=
# 是否自动启动农场浏览器：
#   1（默认）= 后台模式，playwright 自动开浏览器产参数，无需人工干预
#              （默认有头，故桌面上会出现一个 Chrome 窗口——别关它）
#   0        = 手动模式，需用你自己的 Chrome 打开 farm 页并保持标签页
FARM_AUTO_BROWSER=1
# 有头模式下把农场窗口最小化到任务栏（屏幕上看不到它）。
# 0（默认）= 窗口可见；1 = 启动即最小化。
# 仅在有头模式下有效（FARM_HEADLESS=1 时忽略，无头本来就没窗口）。
# 这不是无头——实测最小化状态下农场照常产出参数。但它依赖"SDK 不检查窗口可见性"
# 这一尚未被机制性证实的假设，失效时会静默变成 F011 + 产出归零；
# 所以怀疑农场有问题时，先改成 0 用可见窗口复现。
FARM_MINIMIZED=0
# 参数池上限与 TTL(ms)
POOL_SIZE=6
PARAM_TTL_MS=480000
# 参数被上游**接受**的时效(ms)，短于 PARAM_TTL_MS（后者只是内存保留时长）。
# 超过它的参数会被池直接丢弃，不再递给上游——实测 48s 的参数已被判 3007，
# 而池里 4 个陈参数会让一次请求把初次+2 次重试全打在陈参数上，客户端拿到 400。
PARAM_USABLE_MS=40000
# 单账号最小请求间隔(ms)；3012 冷却分钟；换号/换参重试上限
ACCOUNT_MIN_INTERVAL_MS=2000
COOLDOWN_3012_MIN=30
MAX_RETRIES=2
# 1005 连续熔断：同一（账号, 模型）连续 N 次 1005 → 不看余额按模型雪藏 M 分钟
C1005_TRIP=3
C1005_BENCH_MIN=30
# 局域网访问看板密码（空=仅本机免密）
# 注意：这只是**引导密码**。在面板「设置」里改过密码后会写入 panel.json（scrypt 哈希），
# 之后以此文件里的值为准、本项失效。未设置任何密码时，非本机一律 401。
PANEL_PASSWORD=
# 本机是否免密进管理面板。默认 1（本机工具的使用直觉）。
# 面板挂在反向代理后面时设 0：代理回源地址是本机，开着放行等于任何人都能进管理面。
PANEL_LOCAL_BYPASS=1
# 完全免密（含非本机）。默认 0。
# 打开后任何能连到这个端口的人都能管理账号与 API Key —— 只在可信局域网里开。
# 也可以在面板「设置 → 从其他设备访问」里一键开关（即时生效，无需重启）。
PANEL_DISABLE_AUTH=0

# ── 本机登录扫描（面板「⤓ 扫描本机 ZCode 登录」）──────────────────────────
# 默认会扫：~/.zcode/v2/credentials.json（默认实例）
#        + %APPDATA%\zcode-multi\<N>\data\.zcode\v2\credentials.json（多开管理器各实例）
# 下面两项一般不用设，只有隔离 profile / 自定义密钥时才需要：

# 只从这个文件读凭据（设了就不再扫多开实例）。用于隔离 profile：
# ZCODE_CREDENTIALS_FILE=D:\isolated\.zcode\v2\credentials.json

# 凭据解密密钥的覆盖值。ZCode 客户端支持用它覆盖加密密钥；
# 若你给客户端设过，这里也要设成同一个值，否则扫出来的凭据解不开。
# ZCODE_CREDENTIAL_SECRET=
