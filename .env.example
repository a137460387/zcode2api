# 对外 API 鉴权 key（必填）
API_KEY=sk-zcode2api-local
# API 监听（默认 127.0.0.1:8787）
HOST=127.0.0.1
PORT=8787
# farm 服务（浏览器参数农场页）端口
FARM_PORT=8789
# 账号文件目录 / 证书目录
POOL_DIR=./accounts
CERT_DIR=./certs
# 农场自动浏览器：1=无头（默认），0=有头；CHROME_PATH 留空用系统 Chrome
FARM_HEADLESS=1
CHROME_PATH=
# 参数池上限与 TTL(ms)
POOL_SIZE=6
PARAM_TTL_MS=480000
# 单账号最小请求间隔(ms)；3012 冷却分钟；换号/换参重试上限
ACCOUNT_MIN_INTERVAL_MS=2000
COOLDOWN_3012_MIN=30
MAX_RETRIES=2
# 局域网访问看板密码（空=仅本机免密）
PANEL_PASSWORD=
